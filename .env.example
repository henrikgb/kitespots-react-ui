# Copy this file to .env and fill in real values for local development. .env is gitignored and
# must never be committed - see .gitignore / .dockerignore.
#
# SECURITY BOUNDARY (Phase 8): the Azure Storage account connection string below grants full
# read/write access to the whole storage account. It must only ever be read by server-only code
# (src/repository/*.ts, src/service/*.ts, invoked exclusively from src/pages/api/*.ts) and must
# NEVER be assigned to a NEXT_PUBLIC_* variable, referenced from a React component, or passed as
# a Docker build ARG - any of those would ship it to every visitor's browser. The intended flow
# is:
#
#   Browser -> same-origin Next.js API route -> server-only env var -> @azure/storage-blob -> Azure Blob Storage
#
# Only variables explicitly prefixed NEXT_PUBLIC_ are safe to expose to the browser (Next.js
# inlines them into the client bundle at build time). Every other variable below is server-only.

# --- Server-only: Azure Blob Storage -----------------------------------------------------------

# Full read/write connection string for the kitespotsad77 storage account. Used only by
# src/repository/LocationsRepository.ts, LocationImagesRepository.ts, and WeatherDataRepository.ts,
# which are only ever imported by src/pages/api/*.ts (server-side) - never by a React component.
# SECRET - get the real value from the Azure Portal (Storage Account > Access keys) or an
# existing team member; never commit it.
AZURE_KITESPOTSAD77_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net"

# Public, read-only base URL for the storage account's public containers (account root, not a
# container URL - imageBlobName values already include the "location-images/" prefix). Not a
# secret - the "location-images" container is configured for anonymous *read* access to
# individual blobs only (public access level "blob", no container listing). Server-only purely
# because it's only ever read from src/types/model/Location.ts's getLocationImageUrl, called
# server-side when building API responses - it is not itself sensitive.
AZURE_BLOB_PUBLIC_BASE_URL="https://<account>.blob.core.windows.net"

# --- Server-only: NextAuth / Azure AD sign-in ----------------------------------------------------

# Explicit base URL for NextAuth's OAuth callback construction (recommended by NextAuth docs).
NEXTAUTH_URL="http://localhost:3000"

# Azure AD app registration used for admin sign-in (see src/pages/api/auth/[...nextauth].ts).
# SECRET (the client secret) - get real values from the Azure AD app registration.
AZURE_AD_CLIENT_ID="<azure-ad-app-registration-client-id>"
AZURE_AD_CLIENT_SECRET="<azure-ad-app-registration-client-secret>"
AZURE_AD_TENANT_ID="<azure-ad-tenant-id-or-common>"

# NextAuth session encryption secret. SECRET - generate a new one per environment, e.g.
# `openssl rand -hex 32`; never reuse the same value across environments.
KITESPOTS_SECRET="<generate-a-random-secret-e.g-openssl-rand-hex-32>"

# --- Public: safe to expose to the browser -------------------------------------------------------

# Comma-separated allowlist of emails permitted to manage kite spots (add/delete/upload image).
# Not a secret (just email addresses) - see src/domain/adminAuthorization.ts. NEXT_PUBLIC_ so the
# same list can also drive the client-side UI hint; the *authoritative* check is always
# server-side in src/util/auth/requireSession.ts, so a tampered/missing client value cannot grant
# access. If unset, every authenticated session is treated as authorized.
NEXT_PUBLIC_KITESPOTS_ADMIN_EMAILS="you@example.com"
